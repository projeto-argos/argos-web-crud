DB_URL=jdbc:postgresql://HOST:PORTA/NOME_DO_BANCO?sslmode=require
DB_USER=
DB_PASSWORD=

# Cloudflare Turnstile - chave SECRETA
TURNSTILE_SECRET=

# Só na hospedagem (Render), que usa HTTPS: cookie da sessão com Secure
# COOKIE_SECURE=true
# Para testar a política de segurança (CSP) sem bloquear nada: CSP_REPORT_ONLY=true
# Opcional: máximo de conexões com o banco (1 a 8; padrão 3). O Aiven aceita 20 no total
# DB_POOL_MAX=3
